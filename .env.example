# Скопируйте этот файл в .env и заполните значения из Supabase:
# Dashboard → Project Settings → API (или Data API / API Keys).

# Project URL, например https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Публичный ключ: "anon public" (JWT) или "publishable" (sb_publishable_...).
# НИКОГДА не вставляйте сюда service_role / secret key — приложение откажется запускаться.
VITE_SUPABASE_ANON_KEY=

# Необязательно: кнопки входа через OAuth. Указывайте провайдера, только если он
# включён и настроен в Supabase (Authentication → Providers). Пример: google,github
VITE_AUTH_PROVIDERS=

# Загрузка фото домиков в Cloudinary (см. README → «Cloudinary»).
# Cloud name — из Cloudinary Dashboard. Upload preset — имя UNSIGNED preset.
# API Secret сюда НЕ вставлять. Если оставить пустым — фото грузятся в Supabase Storage.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
